{
  "expo": {
    "name": "Quiett",
    "slug": "quiett",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quiett",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rossduris.quiett",
      "infoPlist": {
        "NSCameraUsageDescription": "Quiett uses the front camera to check that you’re settled and still before your morning alarm turns off. The video is analyzed on your iPhone and never leaves it.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAlarmKitUsageDescription": "Quiett schedules your morning alarm so it can ring even when your phone is locked. It turns off once you’ve settled in for a quiet moment."
      },
      "appleTeamId": "EY7Z8634G7"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6E4D8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.rossduris.quiett"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6E4D8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Quiett uses the front camera to check that you’re settled and still before your morning alarm turns off. The video is analyzed on your iPhone and never leaves it.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "./plugins/withQuiettAlarmScheduler.js",
        {
          "alarmKitUsageDescription": "Quiett schedules your morning alarm so it can ring even when your phone is locked. It turns off once you’ve settled in for a quiet moment.",
          "iosAlarmSounds": [
            "./assets/audio/quiett-harsh.caf",
            "./assets/audio/alarms/rise-and-shine.caf",
            "./assets/audio/alarms/early-bright.caf",
            "./assets/audio/alarms/fresh-morning.caf",
            "./assets/audio/alarms/new-day.caf",
            "./assets/audio/alarms/sunbeam.caf",
            "./assets/audio/alarms/dayspring.caf",
            "./assets/audio/alarms/peaceful.caf",
            "./assets/audio/alarms/slow-wind.caf",
            "./assets/audio/alarms/dawn-rain.caf",
            "./assets/audio/alarms/coastal-breeze.caf",
            "./assets/audio/alarms/hazy-day.caf",
            "./assets/audio/alarms/new-breath.caf"
          ]
        }
      ],
      "expo-asset",
      "./plugins/withoutPushEntitlement.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
