{
  "expo": {
    "name": "Quiett",
    "slug": "quiett",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-s7f/icon-1024.png",
    "scheme": "quiett",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rossduris.quiett",
      "buildNumber": "4",
      "infoPlist": {
        "NSCameraUsageDescription": "Quiett uses the front camera to check that you\u2019re settled and still before your morning alarm turns off. The video is analyzed on your iPhone and never leaves it.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAlarmKitUsageDescription": "Quiett schedules your morning alarm so it can ring even when your phone is locked. It turns off once you\u2019ve settled in for a quiet moment.",
        "NSMotionUsageDescription": "Quiett uses your iPhone\u2019s motion sensors to tell when the phone is propped up for your morning check. This stays on your iPhone."
      },
      "appleTeamId": "JZ8YVDHL4P",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6E4D8",
        "foregroundImage": "./assets/images/icon-s7f/android-adaptive-foreground-1024.png",
        "backgroundImage": "./assets/images/icon-s7f/android-adaptive-background-1024.png",
        "monochromeImage": "./assets/images/icon-s7f/android-monochrome-1024.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.rossduris.quiett"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-s7f/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6E4D8",
          "image": "./assets/images/icon-s7f/splash-icon-1024.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Quiett uses the front camera to check that you\u2019re settled and still before your morning alarm turns off. The video is analyzed on your iPhone and never leaves it.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "./plugins/withQuiettAlarmScheduler.js",
        {
          "alarmKitUsageDescription": "Quiett schedules your morning alarm so it can ring even when your phone is locked. It turns off once you\u2019ve settled in for a quiet moment.",
          "iosAlarmSounds": [
            "./assets/audio/alarms/rise-and-shine.caf",
            "./assets/audio/alarms/early-bright.caf",
            "./assets/audio/alarms/fresh-morning.caf",
            "./assets/audio/alarms/new-day.caf",
            "./assets/audio/alarms/sunbeam.caf",
            "./assets/audio/alarms/dayspring.caf",
            "./assets/audio/alarms/peaceful.caf",
            "./assets/audio/alarms/slow-wind.caf",
            "./assets/audio/alarms/dawn-rain.caf",
            "./assets/audio/alarms/coastal-breeze.caf",
            "./assets/audio/alarms/hazy-day.caf",
            "./assets/audio/alarms/new-breath.caf"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Quiett lets you choose a profile photo from your library. It stays on your iPhone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withoutPushEntitlement.js",
      "expo-localization",
      [
        "./plugins/withAccentColor.js",
        {
          "color": "#BA5838"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
