# RevenueCat public SDK keys (safe to ship in the app; NOT the secret API key).
# Copy this file to .env.local and fill in the keys from
# RevenueCat → Project settings → API keys → "Public app-specific API keys".
# With no key the app runs in "purchases unavailable" mode (free tier, no prices).
# iOS key looks like appl_XXXXXXXX
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Android key (later) looks like goog_XXXXXXXX
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
